{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boomly",
  "version": "0.1.0",
  "identifier": "com.orionz43.boomly",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Boomly",
        "minWidth": 720,
        "minHeight": 480,
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Z43 Studios",
    "copyright": "© 2026 Orion Z43 / Z43 Studios. MIT License.",
    "category": "Music",
    "shortDescription": "Boomly — саундпад для Windows",
    "longDescription": "Boomly — саундпад для Windows: звуки по горячим клавишам в микрофон через VB-CABLE.",
    "homepage": "https://github.com/OrionZ43/boomly",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQ0VCRjEzRjQwNjU5QjgKUldTNFdRYjBFNy9PT3pMbDdMY0ZUcVZpUlpIOC9xUmYxVjB4R2JvQVlNcGNqMkg5TkxYVWU4bDQK",
      "endpoints": [
        "https://github.com/OrionZ43/boomly/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
